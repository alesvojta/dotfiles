                    "reveal": "hover",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 8,
                  "gap": 8,
                  "lone": true
                }
              },
              "padding": 8
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "background": "chrome",
          "padding": 0,
          "gap": 8
        },
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-custom"
          },
          "size": {
            "px": 30
          },
          "window_drag": true
        }
      ],
      "resizable": false
