{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "piInfrastructureReadPaths": [
    "~/Library/*/node_modules/@earendil-works/pi-coding-agent/*"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "path_write": {
      ".pi/*": "ask",
      ".git/hooks/*": "ask",
      "*lefthook.yml": "ask"
    },
    "external_directory": {
      "*": "ask"
    },
    "external_directory_read": {
      "~/.agents/skills/*": "allow",
      "~/.config/herdr-app/*": "allow"
    },
    "bash": {
      "*": "ask",
      "true": "allow",
      "false": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "pwd *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "file *": "allow",
      "echo *": "allow",
      "diff *": "allow",
      "printf *": "allow",
      "mkdir *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "which *": "allow",
      "nl *": "allow",
      "ps *": "allow",
      "sed -n *": "allow",
      "rex *": "allow",
      "hc *": "allow",
      "herdr-app *": "allow",
      "node --version": "allow",
      "pnpm --version": "allow",
      "pnpm storybook:*": "allow",
      ".agents/skills/pr-summary/scripts/pr-diff.sh *": "allow",
      ".agents/skills/standup-summary/scripts/collect-standup-git-history.sh *": "allow",
      "git status *": "allow",
      "git tag *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git reset *": "allow",
      "git commit *": "allow",
      "git branch *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git remote show *": "allow",
      "git fetch *": "allow",
      "git restore --staged *": "allow",
      "git check-ignore *": "allow",
      "git ls-tree *": "allow",
      "git ls-remote origin": "allow",
      "git ls-remote --heads origin *": "allow",
      "git ls-remote --tags origin *": "allow",
      "git show-ref *": "allow",
      "git rev-list *": "allow",
      "git blame *": "allow",
      "find *-delete*": "ask",
      "find *-fprint*": "ask",
      "find *-fls*": "ask",
      "find . -delete": "deny",
      "sed *-i*": "ask",
      "sed *--in-place*": "ask",
      "git restore *--worktree*": "ask",
      "git restore *-W*": "ask",
      "git commit *--no-verify*": "ask",
      "git tag -d *": "ask",
      "git branch -D *": "deny",
      "git reset --hard*": "ask",
      "git reset --hard HEAD~*": "deny",
      "git clean -fdx*": "deny",
      "git push *--force*": "deny",
      "git push *--force-with-lease*": "ask",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "git push origin :*": "deny",
      "git push *--delete*": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git reflog expire *": "deny",
      "dropdb *": "deny",
      "psql * -c \"DROP *\"": "deny",
      "mongo * --eval \"db.dropDatabase()\"": "deny",
      "redis-cli FLUSHALL": "deny",
      "redis-cli FLUSHDB": "deny",
      "npx prisma migrate reset": "deny",
      "npx prisma db push --force-reset": "deny",
      "npx sequelize-cli db:drop": "deny",
      "npx typeorm schema:drop": "deny",
      "docker rm -f *": "deny",
      "docker rmi -f *": "deny",
      "docker system prune -a": "deny",
      "docker volume rm *": "deny",
      "docker volume prune": "deny",
      "docker-compose down -v": "deny",
      "terraform destroy *-auto-approve*": "deny",
      "aws s3 rb s3://* --force": "deny",
      "aws s3 rm s3://* --recursive": "deny",
      "az group delete *": "deny",
      "gcloud * delete": "deny",
      "rm .env*": "deny",
      "rm *.env": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo rm *": "deny",
      "sudo dd *": "deny",
      "chown -R * /": "deny",
      "truncate -s 0 *": "deny",
      "dd if=/dev/zero of=*": "deny",
      "mv * /dev/null": "deny",
      "cp /dev/null *": "deny",
      "shred -u *": "deny",
      "mkfs.*": "deny",
      "fdisk *": "deny"
    },
    "mcp": {
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "subagent": "allow",
    "codemode": "allow"
  }
}
